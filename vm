# === Variabelen ===
IMG="/var/lib/vz/template/iso/ubuntu-22.04-server-cloudimg-amd64.img"
STOR="vmdata"
BRIDGE="vmbr0"
GW="10.24.40.1"
DNS="1.1.1.1"
CIUSER="student"
CIPASS="ChangeMe123!"
CORES=2
MEM_MASTER=4096
MEM_WORKER=3072

# Download cloud image (eenmalig)
mkdir -p /var/lib/vz/template/iso
[ -f "$IMG" ] || curl -L -o "$IMG" \
  https://cloud-images.ubuntu.com/jammy/current/jammy-server-cloudimg-amd64.img


# ---------- VM 401 - MASTER ----------
VMID=401
VMNAME="k8s-master"
VMIP="10.24.40.40/24"
qm stop $VMID 2>/dev/null || true
qm destroy $VMID --purge 2>/dev/null || true
qm create $VMID --name $VMNAME --memory $MEM_MASTER --cores $CORES \
  --cpu host --net0 virtio,bridge=$BRIDGE --agent 1
qm importdisk $VMID "$IMG" $STOR --format qcow2
qm set $VMID --scsihw virtio-scsi-pci --scsi0 ${STOR}:vm-${VMID}-disk-0
qm set $VMID --ide2 ${STOR}:cloudinit
qm set $VMID --boot c --bootdisk scsi0
qm set $VMID --serial0 socket --vga serial0
qm set $VMID --ciuser "$CIUSER" --cipassword "$CIPASS" --nameserver "$DNS"
qm set $VMID --ipconfig0 ip=${VMIP},gw=$GW
qm start $VMID


